MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net
MINERU_USE_SYSTEM_PROXY=false

# Optional local data root for uploads, caches, PDFs, drawings, and generated review output.
# Use a machine-specific value in .env or your shell; do not commit real local paths.
DATA_ROOT=./data

# Dify 完整性审查工作流（仅使用 --dify 时读取）
DIFY_BASE_URL=https://your-dify-host.example/v1
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=180
DIFY_MAX_RETRIES=2
DIFY_RETRY_BACKOFF_SECONDS=1
DIFY_COMPLETENESS_MODE=on_demand
DIFY_CACHE_ENABLED=true
DIFY_WORKFLOW_VERSION=v1
DIFY_PROMPT_VERSION=v2
DIFY_MODEL_IDENTIFIER=unknown
DIFY_OUTPUT_SCHEMA_VERSION=v1

# Web 演示页是否在本地审查后追加调用 Dify（默认关闭）
WEB_ENABLE_DIFY=false

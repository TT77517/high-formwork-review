  "rules": [
    {
      "rule_id": "L-01",
      "rule_name": "永久荷载分项系数",
      "category": "load",
      "severity": "A-mandatory",
      "applicable_types": ["universal"],
      "status": "active",
      "created": "2026-08-19",
      "last_modified": "2026-08-19",
      "check_type": "deterministic",
      "risk_level": "high",
      "plan_facts": {
        "param_name": "永久荷载分项系数γG",
        "plan1_value": 1.3,
        "plan1_location": "计算书荷载系数参数表（第78/94页）",
        "plan2_value": "正文未直接标注",
        "plan2_location": null
      },
      "code_ref": {
        "standard": "GB55001-2021",
        "clause": "第3.1.13条第1款",
        "original_text": "永久作用，当对结构不利时，不应小于1.3，当对结构有利时，不应大于1.0",
        "threshold": {"param": "γG", "operator": ">=", "value": 1.3},
        "is_mandatory": true,
        "effective_date": "2022-01-01"
      },
      "legacy_code_ref": {
        "standard": "JGJ162-2016",
        "clause": "第4.2.3条",
        "old_value": 1.2,
        "note": "旧版1.2已被GB55001-2021取代"
      },
      "check_logic": {
        "description": "永久荷载分项系数γG≥1.3（不利时）",
        "extraction_keywords": ["永久荷载分项系数", "γG", "恒载分项系数"],
        "operator": ">=",
        "expected_value": 1.3,
        "fail_condition": "γG<1.3"
      },
      "notes": "方案1取1.3✓。方案编制时间早于2022年1月1日时引用1.2不宜直接判违规"
    },

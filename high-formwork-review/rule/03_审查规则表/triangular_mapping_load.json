      "plan_facts": {
        "param_name": "新浇混凝土侧压力标准值G4k",
        "plan1_value": "min{0.22γct0β1β2v^(1/2), γcH}=min{29.868, 134.88}=29.868kN/m²",
        "plan1_location": "梁侧模板/墙模板计算书（第70页）",
        "plan2_value": "计算书外挂未提取",
        "plan2_location": null
      },
      "code_ref": {
        "standard": "JGJ162-2016",
        "clause": "第4.1.3条",
        "original_text": "新浇混凝土侧压力标准值F=0.22γct0β1β2v^(1/2)且F≤γcH；其中γc=24kN/m³",
        "formula": "F = min(0.22·γc·t0·β1·β2·V^0.5, γc·H)"
      },
      "check_logic": {
        "description": "①侧压力取两者较小值；②γc=24kN/m³；③β1、β2取值合理",
        "extraction_keywords": ["侧压力", "G4k", "β1", "β2", "初凝时间", "浇筑速度"],
        "operator": "formula_verification",
        "verification_steps": [
          "确认γc=24kN/m³",
          "确认t0（初凝时间）取值合理",
          "确认β1（外加剂系数）取值合理",
          "确认β2（坍落度系数）取值合理",
          "确认V（浇筑速度）取值合理",
          "确认取两式较小值"
        ]
      }
    },

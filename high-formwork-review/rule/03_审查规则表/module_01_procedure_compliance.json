{
  "module_id": "module_01_procedure_compliance",
  "name": "程序合规性审查",
  "description": "审查专项方案的程序合规性，包括危大工程判定、编制审批流程、专家论证要求等",
  "rules": [
    {
      "rule_id": "1.1",
      "rule_name": "危大工程判定-高度阈值",
      "check_content": "搭设高度≥5m的模板工程应判定为危大工程，须编制专项施工方案",
      "threshold": { "param": "搭设高度", "operator": ">=", "value": 5, "unit": "m" },
      "code_ref": "建办质〔2018〕31号-附件一第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.2",
      "rule_name": "危大工程判定-跨度阈值",
      "check_content": "搭设跨度≥10m的模板工程应判定为危大工程，须编制专项施工方案",
      "threshold": { "param": "搭设跨度", "operator": ">=", "value": 10, "unit": "m" },
      "code_ref": "建办质〔2018〕31号-附件一第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.3",
      "rule_name": "危大工程判定-施工总荷载阈值",
      "check_content": "施工总荷载≥10kN/m²的模板工程应判定为危大工程，须编制专项施工方案",
      "threshold": { "param": "施工总荷载", "operator": ">=", "value": 10, "unit": "kN/m²" },
      "code_ref": "建办质〔2018〕31号-附件一第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.4",
      "rule_name": "危大工程判定-集中线荷载阈值",
      "check_content": "集中线荷载≥15kN/m的模板工程应判定为危大工程，须编制专项施工方案",
      "threshold": { "param": "集中线荷载", "operator": ">=", "value": 15, "unit": "kN/m" },
      "code_ref": "建办质〔2018〕31号-附件一第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.5",
      "rule_name": "超过一定规模判定-高度阈值",
      "check_content": "搭设高度≥8m应判定为超过一定规模的危大工程，须组织专家论证",
      "threshold": { "param": "搭设高度", "operator": ">=", "value": 8, "unit": "m" },
      "code_ref": "建办质〔2018〕31号-附件二第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.6",
      "rule_name": "超过一定规模判定-跨度阈值",
      "check_content": "搭设跨度≥18m应判定为超过一定规模的危大工程，须组织专家论证",
      "threshold": { "param": "搭设跨度", "operator": ">=", "value": 18, "unit": "m" },
      "code_ref": "建办质〔2018〕31号-附件二第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.7",
      "rule_name": "超过一定规模判定-施工总荷载阈值",
      "check_content": "施工总荷载≥15kN/m²应判定为超过一定规模的危大工程，须组织专家论证",
      "threshold": { "param": "施工总荷载", "operator": ">=", "value": 15, "unit": "kN/m²" },
      "code_ref": "建办质〔2018〕31号-附件二第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.8",
      "rule_name": "超过一定规模判定-集中线荷载阈值",
      "check_content": "集中线荷载≥20kN/m应判定为超过一定规模的危大工程，须组织专家论证",
      "threshold": { "param": "集中线荷载", "operator": ">=", "value": 20, "unit": "kN/m" },
      "code_ref": "建办质〔2018〕31号-附件二第4项",
      "severity": "critical"
    },
    {
      "rule_id": "1.9",
      "rule_name": "方案编制单位",
      "check_content": "专项施工方案应由施工单位组织编制，不得由分包单位或外部咨询机构编制",
      "code_ref": "住建部37号令-第十一条",
      "severity": "critical"
    },
    {
      "rule_id": "1.10",
      "rule_name": "技术负责人审核",
      "check_content": "专项施工方案须经施工单位技术负责人审核签字",
      "code_ref": "住建部37号令-第十一条",
      "severity": "critical"
    },
    {
      "rule_id": "1.11",
      "rule_name": "总监理工程师审查",
      "check_content": "专项施工方案须经总监理工程师审查签字",
      "code_ref": "住建部37号令-第十一条",
      "severity": "critical"
    },
    {
      "rule_id": "1.12",
      "rule_name": "专家论证程序",
      "check_content": "超过一定规模的危大工程，专项方案须经专家组论证通过后方可实施",
      "code_ref": "住建部37号令-第十二条",
      "severity": "critical"
    },
    {
      "rule_id": "1.13",
      "rule_name": "专家组成员数量",
      "check_content": "专家组应由不少于5名符合相关专业要求的专家组成",
      "threshold": { "param": "专家数量", "operator": ">=", "value": 5, "unit": "人" },
      "code_ref": "住建部37号令-第十二条",
      "severity": "critical"
    },
    {
      "rule_id": "1.14",
      "rule_name": "方案内容完整性",
      "check_content": "方案须包含五项基本内容：工程概况、编制依据、施工计划、施工工艺技术、施工安全保证措施",
      "code_ref": "住建部37号令-第十一条",
      "severity": "critical"
    },
    {
      "rule_id": "1.15",
      "rule_name": "方案附加内容",
      "check_content": "方案应包含计算书及施工图（包括平面图、立面图、剖面图、节点大样图）",
      "code_ref": "住建部37号令-第十一条",
      "severity": "critical"
    },
    {
      "rule_id": "1.16",
      "rule_name": "方案修订与实施",
      "check_content": "专家论证后需修改的，应按专家意见修改后报监理审核；实施过程中方案有变更的应重新论证",
      "code_ref": "住建部37号令-第十三条",
      "severity": "critical"
    },
    {
      "rule_id": "1.17",
      "rule_name": "方案内容完整性-GB55023强制",
      "check_content": "脚手架专项施工方案应包含10项内容：1工程概况和编制依据、2脚手架类型选择、3所用材料构配件类型及规格、4结构与构造设计施工图、5结构设计计算书、6搭设拆除施工计划、7搭设拆除技术要求、8质量控制措施、9安全控制措施、10应急预案",
      "code_ref": "GB 55023-2022 第2.0.3条（全文强制）",
      "severity": "critical",
      "applies_to": ["universal"]
    },
    {
      "rule_id": "1.18",
      "rule_name": "安全技术交底-GB55023强制",
      "check_content": "脚手架搭设和拆除作业前，应将专项施工方案向施工现场管理人员及作业人员进行安全技术交底",
      "code_ref": "GB 55023-2022 第2.0.4条（全文强制）",
      "severity": "critical",
      "applies_to": ["universal"]
    },
    {
      "rule_id": "1.19",
      "rule_name": "方案修改审批-GB55023强制",
      "check_content": "当脚手架专项施工方案需要修改时，修改后的方案应经审批后实施",
      "code_ref": "GB 55023-2022 第2.0.6条（全文强制）",
      "severity": "critical",
      "applies_to": ["universal"]
    },
    {
      "rule_id": "1.20",
      "rule_name": "使用中结构体系不变更",
      "check_content": "脚手架使用过程中，不应改变其结构体系",
      "code_ref": "GB 55023-2022 第2.0.5条（全文强制）",
      "severity": "critical",
      "applies_to": ["universal"]
    }
  ]
}

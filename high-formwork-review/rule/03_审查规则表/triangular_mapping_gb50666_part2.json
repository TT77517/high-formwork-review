      "plan_facts": {
        "param_name": "支架地基处理方式",
        "plan1_value": "需查方案具体描述",
        "plan1_location": "方案构造要求章节",
        "plan2_value": "需查方案具体描述",
        "plan2_location": null
      },
      "code_ref": {
        "standard": "GB50666-2011",
        "clause": "第4.4.4条",
        "original_text": "支架立柱和竖向模板安装在土层上时：1应设置具有足够强度和支承面积的垫板；2土层应坚实并有排水措施；3对软土地基可采用堆载预压调整高度",
        "threshold": {"垫板": "足够强度和支承面积", "排水": "必须有", "软土": "堆载预压"}
      },
      "check_logic": {
        "description": "①土层上安装支架须设垫板；②土层须坚实且有排水措施；③软土地基须采取处理措施",
        "extraction_keywords": ["地基", "垫板", "垫木", "基础", "土层", "排水", "软土", "预压"],
        "operator": "semantic_check",
        "fail_condition": "土层地基未设垫板或无排水措施"
      }
    },
    {
      "rule_id": "G-04",

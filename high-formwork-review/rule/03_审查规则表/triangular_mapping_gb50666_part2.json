      "code_ref": {
        "standard": "GB50666-2011",
        "clause": "第4.4.6条",
        "original_text": "对跨度不小于4m的梁、板，其模板施工起拱高度宜为梁、板跨度的1/1000~3/1000。起拱不得减少构件的截面高度",
        "threshold": {"min_span": 4, "unit": "m", "range": "1/1000~3/1000"}
      },
      "check_logic": {
        "description": "跨度≥4m的梁板模板应起拱，起拱高度为跨度的1/1000~3/1000",
        "extraction_keywords": ["起拱", "拱度", "跨度", "预拱", "起拱高度"],
        "operator": "range_check",
        "expected_range": ["1/1000", "3/1000"],
        "fail_condition": "跨度≥4m未起拱或起拱值超范围"
      }
    },
    {
      "rule_id": "G-05",

      "code_ref": {
        "standard": "GB50666-2011",
        "clause": "第4.5.2条",
        "original_text": "底模及支架应在混凝土强度达到设计要求后拆除；设计无要求时同条件养护试件抗压强度应满足：板≤2m→≥50%, 板2~8m→≥75%, 板>8m→≥100%; 梁≤8m→≥75%, 梁>8m→≥100%; 悬臂→≥100%",
        "threshold": {
          "板_≤2m": 50, "板_2~8m": 75, "板_>8m": 100,
          "梁_≤8m": 75, "梁_>8m": 100,
          "悬臂": 100,
          "unit": "%"
        }
      },
      "check_logic": {
        "description": "拆模时混凝土强度须达到表4.5.2要求(按构件类型和跨度)",
        "extraction_keywords": ["拆模", "拆除", "混凝土强度", "抗压强度", "同条件养护", "试件"],
        "operator": "multi_threshold",
        "fail_condition": "拆模时混凝土强度未达标"
      }
    },

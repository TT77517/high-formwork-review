{
  "module_id": "triangular_mapping_material",
  "name": "三方映射-材料与构造参数",
  "description": "方案事实×规范条款=审查规则。每条规则包含方案中可提取的参数事实、规范条款原文阈值、检查方式和风险等级",
  "methodology": "设计方案4.4节：利用施工方案反向建立检查项",
  "rules": [
    {
      "rule_id": "M-01",
      "rule_name": "立杆钢材材质等级",
      "category": "material",
      "severity": "B-required",
      "applicable_types": ["pankou"],
      "status": "active",
      "created": "2026-08-19",
      "last_modified": "2026-08-19",
      "check_type": "deterministic",
      "risk_level": "medium",
      "plan_facts": {
        "param_name": "立杆钢材材质",
        "plan1_value": "f=300N/mm²（对应Q355）",
        "plan1_location": "计算书立杆截面参数表（第88页等）",
        "plan2_value": "Q345 A48×3.2",
        "plan2_location": "第21页梁支模设计表"
      },
      "code_ref": {
        "standard": "JGJ/T 231-2021",
        "clause": "附录B 表B.0.1",
        "original_text": "Q355钢材抗拉、抗压、抗弯强度设计值300N/mm²；Q235钢材205N/mm²；Q195钢材175N/mm²；弹性模量2.06×10⁵N/mm²",
        "threshold": {"立杆": "Q355(f=300)", "水平杆": "Q235(f=205)", "斜杆": "Q195(f=175)"}
      },
      "legacy_code_ref": {
        "standard": "JGJ231-2010",
        "clause": "第3.2.1条",
        "old_threshold": {"立杆": "Q345(f=300)"},
        "note": "2010版称Q345，2021版改称Q355（钢材牌号命名变更GB/T1591-2018），强度设计值仍为300N/mm²"
      },
      "check_logic": {
        "description": "检查方案中立杆材质是否标注为Q355(2021版)或Q345(2010版)，强度设计值f=300N/mm²",
        "extraction_keywords": ["Q355", "Q345", "立杆材质", "抗压强度设计值", "f=300", "钢材等级"],
        "operator": "equals",
        "expected_value": "Q355或Q345(f=300N/mm²)",
        "fail_condition": "标注Q235或未标注材质等级"
      },
      "notes": "Q345和Q355是同一钢材不同命名(GB/T1591-2018更名)，强度设计值相同均300N/mm²。方案2标注Q345(旧名)不违规"
    },
    {
      "rule_id": "M-02",
      "rule_name": "钢管外径与壁厚一致性",
      "category": "material",
      "severity": "A-mandatory",
      "applicable_types": ["pankou"],
      "status": "active",
      "created": "2026-08-19",
      "last_modified": "2026-08-19",
      "check_type": "deterministic",
      "risk_level": "high",
      "plan_facts": {
        "param_name": "钢管规格（外径×壁厚）",
        "plan1_value": "材料表Φ48×3.0，计算书Φ48×3.2（矛盾）",
        "plan1_location": "材料表第11页、计算书第88页",
        "plan2_value": "立杆A48×3.2，主梁/柱箍Φ48×2.8",
        "plan2_location": "第19-21页参数表、第51页"
      },
      "code_ref": {
        "standard": "JGJ/T 231-2021",
        "clause": "附录B 表B.0.2",
        "original_text": "钢管截面特性：外径48.3mm壁厚3.2mm→A=453mm²,i=16.0mm；外径48.3mm壁厚2.5mm→A=360mm²；外径60.3mm壁厚3.2mm→A=574mm²",
        "threshold": {"standard_OD_B型": "48.3mm", "standard_OD_Z型": "60.3mm", "wall_thickness_tolerance": "±0.1mm"}
      },
      "check_logic": {
        "description": "①检查方案材料表与计算书中钢管规格是否一致；②壁厚偏差是否在±0.1mm内",
        "extraction_keywords": ["Φ48", "A48", "壁厚", "钢管规格", "截面类型"],
        "operator": "consistency_check",
        "expected_value": "材料表与计算书钢管规格一致",
        "fail_condition": "材料表与计算书钢管壁厚不一致"
      },
      "notes": "方案1存在材料表Φ48×3.0 vs 计算书Φ48×3.2矛盾，是典型审查发现"
    },
    {
      "rule_id": "M-03",
      "rule_name": "可调托座悬臂长度与丝杆外露",
      "category": "material",
      "severity": "A-mandatory",
      "applicable_types": ["pankou"],
      "status": "active",
      "created": "2026-08-19",
      "last_modified": "2026-08-19",
      "check_type": "deterministic",
      "risk_level": "high",
      "plan_facts": {
        "param_name": "可调托座悬臂长度/丝杆外露长度",
        "plan1_value": "悬臂长度450mm",
        "plan1_location": "参数表第13-17页",
        "plan2_value": "悬臂≤650mm、丝杆外露≤400mm（构造要求引用）",
        "plan2_location": "第44页构造要求"
      },
      "code_ref": {
        "standard": "JGJ/T 231-2021",
        "clause": "第6.2.4条",
        "original_text": "可调托撑伸出顶层水平杆或双槽托梁中心线的悬臂长度不应超过650mm，且丝杆外露长度不应超过400mm，可调托撑插入立杆或双槽托梁长度不得小于150mm",
        "threshold": [
          {"param": "悬臂长度", "operator": "<=", "value": 650, "unit": "mm", "strict": true},
          {"param": "丝杆外露", "operator": "<=", "value": 400, "unit": "mm", "strict": true},
          {"param": "插入立杆长度", "operator": ">=", "value": 150, "unit": "mm"}
        ],
        "is_mandatory": false
      },
      "check_logic": {
        "description": "①悬臂长度≤650mm（严禁）；②丝杆外露≤400mm（严禁）；③插入立杆≥150mm",
        "extraction_keywords": ["可调托座", "悬臂", "丝杆外露", "伸出顶层水平杆"],
        "operator": "multi_threshold",
        "fail_condition": "任一阈值超限"
      },
      "notes": "方案1悬臂450mm<650mm✓；方案2在构造要求中引用规范限值但未标注实际值"
    },
    {
      "rule_id": "M-04",
      "rule_name": "可调底座丝杆外露与扫地杆高度",
      "category": "material",
      "severity": "B-required",
      "applicable_types": ["pankou"],
      "status": "active",
      "created": "2026-08-19",
      "last_modified": "2026-08-19",
      "check_type": "deterministic",
      "risk_level": "high",
      "plan_facts": {
        "param_name": "可调底座丝杆外露长度/扫地杆离地高度",
        "plan1_value": "扫地杆≤350mm（第20页引JGJ162）或≤550mm（第32页引JGJ231）",
        "plan1_location": "第20页、第32页构造要求",
        "plan2_value": "丝杆外露≤300mm、扫地杆≤550mm",
        "plan2_location": "第44页构造要求"
      },
      "code_ref": {
        "standard": "JGJ/T 231-2021",
        "clause": "第6.2.5条",
        "original_text": "可调底座丝杆插入立杆长度不得小于150mm，丝杆外露长度不宜大于300mm，作为扫地杆的最底层水平杆中心线高度离可调底座的底板高度不应大于550mm",
        "threshold": [
          {"param": "丝杆外露", "operator": "<=", "value": 300, "unit": "mm"},
          {"param": "扫地杆离地高度", "operator": "<=", "value": 550, "unit": "mm"}
        ],
        "is_mandatory": false
      },
      "check_logic": {
        "description": "①丝杆外露≤300mm；②扫地杆离地高度≤550mm",
        "extraction_keywords": ["可调底座", "丝杆外露", "扫地杆", "距地面", "离地"],
        "operator": "multi_threshold",
        "fail_condition": "任一阈值超限"
      },
      "notes": "方案1第20页写350mm引用JGJ162扣件式标准，第32页写550mm引用JGJ231盘扣式标准→标准混用"
    },
    {
      "rule_id": "M-05",
      "rule_name": "可调托座承载力",
      "category": "material",
      "severity": "A-mandatory",
      "applicable_types": ["pankou", "koujian"],
      "status": "active",
      "created": "2026-08-19",
      "last_modified": "2026-08-19",
      "check_type": "deterministic",
      "risk_level": "high",
      "plan_facts": {
        "param_name": "可调托座承载力容许值",
        "plan1_value": "30kN",
        "plan1_location": "计算书可调托座验算表（第87/103页）",
        "plan2_value": "未在正文中标注",
        "plan2_location": null
      },
      "code_ref": {
        "standard": "JGJ/T 231-2021",
        "clause": "第5.1.9条 表5.1.9",
        "original_text": "脚手架可调底座和可调托撑的承载力设计值：标准型(B型)可调底座100kN/可调托撑100kN；重型(Z型)可调底座140kN/可调托撑140kN",
        "threshold": {"B型_底座": 100, "B型_托撑": 100, "Z型_底座": 140, "Z型_托撑": 140, "unit": "kN"},
        "is_mandatory": false,
        "note": "JGJ/T为推荐性标准。盘扣式B型立杆外径48.3mm，Z型立杆外径60.3mm"
      },
      "legacy_code_ref": {
        "standard": "JGJ130-2011",
        "clause": "第3.4.3条",
        "old_threshold": {"可调托撑": 40},
        "note": "JGJ130扣件式标准要求≥40kN。JGJ231-2021盘扣式标准要求B型≥100kN"
      },
      "check_logic": {
        "description": "盘扣式：B型可调托撑≥100kN，Z型≥140kN；扣件式：≥40kN。按支架类型匹配阈值",
        "extraction_keywords": ["可调托座承载力", "可调托撑", "受压承载力", "容许值", "B型", "Z型"],
        "operator": ">=",
        "expected_value": 100,
        "unit": "kN(盘扣B型)",
        "fail_condition": "取值<规范要求"
      },
      "notes": "方案1取30kN远低于JGJ231-2021要求的100kN(B型)。但方案1引用JGJ162-2008旧版，该版未明确100kN限值。实际方案中30kN是计算所取的设计轴力值，非产品承载力限值，需区分"
    },
